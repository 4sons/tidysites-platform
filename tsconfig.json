{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"lib": [
			"ES2022",
			"DOM",
			"DOM.Iterable"
		],
		"types": [
			"@cloudflare/workers-types"
		],
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"noImplicitOverride": true,
		"skipLibCheck": true,
		"noEmit": true,
		"resolveJsonModule": true,
		"isolatedModules": true,
		"verbatimModuleSyntax": true
	},
	"include": [
		"src",
		"test"
	],
	"exclude": [
		"src/editor/runtime.ts",
		"src/editor/revisions.ts",
		"src/editor/confirm.ts",
		"src/editor/request.ts"
	]
}
