---
/**
 * The Tideworthy on-site editor. Mount it from the layout on every page; it
 * renders nothing for a visitor and, for a signed-in editor, a bar across the
 * top of the page: "Edit" while editing is off, the editor's controls while
 * it is on (the `emdash-edit-mode` cookie, set and cleared by /_tidy/edit).
 * Block pages hand it the entry they show, the block schemas the template
 * declares, and the block list as rendered; the template frames each custom
 * block with `data-tidy-block` (its key) and `data-tidy-type`, and wraps the
 * list in `data-tidy-blocks`. A record region (`data-tidy-record`,
 * `data-tidy-record-id`, `data-tidy-record-label`) gets an "Edit details"
 * chip whose form comes from EmDash's manifest. A page without blocks (an
 * article) gets the bar only; EmDash's inline editing handles its prose and
 * its toolbar shows there. While editing is off, EmDash's toolbar is hidden:
 * the bar is the one control. The bar sets `--tidy-bar` on <html> (its
 * height) so a template's sticky header can sit below it.
 */
import type { Block, BlockSchema } from "./ops";

interface Props {
	collection?: string;
	id?: string;
	field?: string;
	blocks?: BlockSchema[];
	value?: Block[] | null;
	/** Records reachable from the bar (the business) or from `[data-tidy-record]` regions on the page. */
	records?: Array<{ collection: string; id: string; label: string }>;
	/** What the bar calls this site; "Staging" by default. */
	label?: string;
}
const { collection, id, field = "content", blocks, value, records = [], label = "Staging" } = Astro.props;
const signedIn = Boolean(Astro.session ? await Astro.session.get("user") : null);
const active = Astro.cookies.get("emdash-edit-mode")?.value === "true";
const here = Astro.url.pathname + Astro.url.search;
const toggle = (on: boolean) => `/_tidy/edit?on=${on ? 1 : 0}&to=${encodeURIComponent(here)}`;
const editable = active && Boolean(collection && id && blocks && value);
const config = editable ? JSON.stringify({ collection, id, field, blocks, value, records, done: toggle(false) }) : null;
const htmlClass = !signedIn ? "" : !active ? "tidy-bar tidy-idle" : editable ? "tidy-bar" : "tidy-bar tidy-inline";
---
{signedIn && (
	<>
		<div class="tidy-bar" id="tidy-bar" role="region" aria-label="Site editing">
			<span class="tidy-bar-label">{label}</span>
			<div class="tidy-bar-actions" id="tidy-bar-actions">
				{!active && <a class="tidy-btn tidy-btn-primary" href={toggle(true)}>Edit</a>}
				{active && !editable && <a class="tidy-btn" href={toggle(false)}>Done</a>}
			</div>
		</div>
		<script is:inline define:vars={{ htmlClass }}>document.documentElement.className += " " + htmlClass;</script>
	</>
)}
{config && (
	<>
		<script type="application/json" id="tidy-editor-config" set:html={config.replace(/</g, "\\u003c")} />
		<script src="./runtime.ts"></script>
	</>
)}
<style is:global>
	.tidy-editing #emdash-toolbar, .tidy-idle #emdash-toolbar { display: none !important; }
	html.tidy-bar { --tidy-bar: 44px; }
	html.tidy-bar body { padding-top: var(--tidy-bar); }
	.tidy-bar { position: fixed; top: 0; left: 0; right: 0; height: var(--tidy-bar, 44px); z-index: 2147483000; display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 0 16px; box-sizing: border-box; background: #17211c; color: #fff; font: 500 13px/1 system-ui, sans-serif; box-shadow: 0 1px 0 rgba(255,255,255,.08), 0 6px 20px rgba(0,0,0,.18); }
	.tidy-bar-label { opacity: .7; letter-spacing: .04em; text-transform: uppercase; font-size: 11px; }
	.tidy-bar-actions { display: flex; align-items: center; gap: 8px; }
	.tidy-bar-actions a { text-decoration: none; }
	.tidy-bar .tidy-btn { padding: 6px 12px; }
	.tidy-bar-count { opacity: .85; margin-right: 4px; }
	.tidy-bar-count:empty { display: none; }
	.tidy-editing [data-tidy-record] { outline: 2px dashed transparent; outline-offset: 4px; transition: outline-color 120ms; cursor: pointer; }
	.tidy-editing [data-tidy-record]:hover, .tidy-editing [data-tidy-record].tidy-active { outline-color: #2b7fd1; }
	.tidy-image-preview { display: grid; place-items: center; min-height: 96px; border: 1px solid #d3dcd6; border-radius: 6px; background: #f6f7f5; overflow: hidden; }
	.tidy-image-preview img { max-width: 100%; max-height: 180px; display: block; }
	.tidy-image-empty { color: #7b877f; font-size: 13px; padding: 8px; }
	.tidy-image-actions { display: flex; gap: 6px; flex-wrap: wrap; }
	.tidy-image-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; max-height: 260px; overflow: auto; padding: 6px; border: 1px solid #d3dcd6; border-radius: 6px; }
	.tidy-image-grid[hidden] { display: none; }
	.tidy-image-thumb { padding: 0; border: 2px solid transparent; border-radius: 6px; overflow: hidden; background: #fff; cursor: pointer; aspect-ratio: 1; }
	.tidy-image-thumb:hover { border-color: #2b7fd1; }
	.tidy-image-thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
	.tidy-editing [data-tidy-block] { position: relative; outline: 2px dashed transparent; outline-offset: -2px; transition: outline-color 120ms; cursor: pointer; }
	.tidy-editing [data-tidy-block]:hover, .tidy-editing [data-tidy-block].tidy-active { outline-color: #2b7fd1; }
	.tidy-chip { position: absolute; z-index: 2147483000; display: flex; gap: 4px; align-items: center; padding: 4px 6px; background: #17211c; color: #fff; border-radius: 8px; font: 500 13px/1.2 system-ui, sans-serif; box-shadow: 0 6px 20px rgba(0,0,0,.25); }
	.tidy-chip[hidden], .tidy-panel[hidden] { display: none; }
	.tidy-chip-label { padding: 0 6px 0 4px; opacity: .85; }
	.tidy-btn { appearance: none; border: 1px solid rgba(255,255,255,.25); background: rgba(255,255,255,.08); color: inherit; border-radius: 6px; padding: 4px 8px; font: inherit; cursor: pointer; }
	.tidy-btn:hover { background: rgba(255,255,255,.18); }
	.tidy-btn:disabled { opacity: .35; cursor: default; }
	.tidy-btn-primary { background: #2b7fd1; border-color: #2b7fd1; color: #fff; }
	.tidy-btn-primary:hover { background: #2470bd; }
	.tidy-btn-danger:hover { background: #b3261e; border-color: #b3261e; }
	.tidy-btn-sm { padding: 3px 8px; font-size: 12px; }
	.tidy-add-end { display: block; width: calc(100% - 32px); margin: 16px; padding: 14px; border: 2px dashed #2b7fd1; border-radius: 10px; background: rgba(43,127,209,.06); color: #2b7fd1; font: 600 14px system-ui, sans-serif; cursor: pointer; }
	.tidy-panel { position: fixed; top: 0; right: 0; bottom: 0; width: min(420px, 100vw); z-index: 2147483001; overflow: auto; background: #fff; color: #17211c; border-left: 1px solid #d3dcd6; box-shadow: -12px 0 40px rgba(0,0,0,.18); padding: 20px; font: 14px/1.45 system-ui, sans-serif; }
	.tidy-panel-head h2 { margin: 0 0 4px; font-size: 18px; }
	.tidy-panel-head p { margin: 0 0 16px; color: #4a5851; }
	.tidy-form { display: grid; gap: 14px; }
	.tidy-field { display: grid; gap: 6px; }
	.tidy-field-label { font-weight: 600; font-size: 13px; }
	.tidy-field input[type="text"], .tidy-field input[type="number"], .tidy-field textarea, .tidy-field select { width: 100%; box-sizing: border-box; border: 1px solid #c9d2cc; border-radius: 6px; padding: 8px 10px; font: inherit; background: #fff; color: inherit; }
	.tidy-field textarea { resize: vertical; min-height: 88px; }
	.tidy-field-toggle { display: flex; align-items: center; gap: 10px; }
	.tidy-repeater { border: 1px solid #d3dcd6; border-radius: 8px; padding: 12px; display: grid; gap: 12px; }
	.tidy-repeater legend { font-weight: 600; padding: 0 6px; }
	.tidy-repeater-item { display: grid; gap: 10px; padding: 12px; background: #f6f7f5; border-radius: 6px; }
	.tidy-panel .tidy-btn { color: #17211c; border-color: #c9d2cc; background: #fff; }
	.tidy-panel .tidy-btn-primary { color: #fff; background: #2b7fd1; border-color: #2b7fd1; }
	.tidy-panel .tidy-btn-danger { color: #b3261e; }
	.tidy-panel-actions { display: flex; gap: 8px; justify-content: flex-end; padding-top: 8px; border-top: 1px solid #e6ede8; }
	.tidy-add-list { display: grid; gap: 8px; margin-bottom: 16px; }
	.tidy-add-item { display: grid; gap: 2px; text-align: left; padding: 10px 12px; border: 1px solid #d3dcd6; border-radius: 8px; background: #fff; cursor: pointer; font: inherit; }
	.tidy-add-item:hover { border-color: #2b7fd1; background: rgba(43,127,209,.06); }
	.tidy-add-item span { color: #4a5851; font-size: 13px; }
</style>
