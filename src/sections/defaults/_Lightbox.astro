---
/** The lightbox every gallery opens its images in: one dialog per page, filled on click from the clicked image's full-size source. */
---
<dialog class="ts-lightbox" data-tidy-lightbox>
	<button class="ts-lightbox-close" type="button" aria-label="Close"><svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true"><path d="M3 3l10 10M13 3L3 13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg></button>
	<button class="ts-lightbox-prev" type="button" aria-label="Previous"><svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true"><path d="M10 3L5 8l5 5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
	<figure class="ts-lightbox-figure"><img class="ts-lightbox-img" alt="" /><figcaption class="ts-lightbox-caption"></figcaption></figure>
	<button class="ts-lightbox-next" type="button" aria-label="Next"><svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true"><path d="M6 3l5 5-5 5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
</dialog>
<script is:inline>
(function(){
	if (window.__tidyLightbox) return; window.__tidyLightbox = true;
	var box, items = [], at = 0;
	function show(i) { at = (i + items.length) % items.length; var it = items[at]; box.querySelector(".ts-lightbox-img").src = it.src; box.querySelector(".ts-lightbox-img").alt = it.alt; box.querySelector(".ts-lightbox-caption").textContent = it.caption; }
	document.addEventListener("click", function (e) {
		var t = e.target instanceof Element ? e.target : null; if (!t) return;
		var fig = t.closest("[data-tidy-lightbox-item]");
		if (fig) {
			e.preventDefault(); box = document.querySelector("dialog[data-tidy-lightbox]"); if (!box) return;
			var group = fig.closest("[data-tidy-lightbox-group]") || document;
			items = [].map.call(group.querySelectorAll("[data-tidy-lightbox-item]"), function (el) { var img = el.querySelector("img"); return { src: el.getAttribute("data-tidy-lightbox-item") || (img && (img.currentSrc || img.src)) || "", alt: img ? img.alt : "", caption: el.getAttribute("data-tidy-lightbox-caption") || "" }; });
			show(items.findIndex(function (x, i) { return group.querySelectorAll("[data-tidy-lightbox-item]")[i] === fig; }));
			box.showModal(); return;
		}
		if (!box) return;
		if (t.closest(".ts-lightbox-prev")) show(at - 1);
		else if (t.closest(".ts-lightbox-next")) show(at + 1);
		else if (t.closest(".ts-lightbox-close") || (t === box)) box.close();
	});
	document.addEventListener("keydown", function (e) { if (!box || !box.open) return; if (e.key === "ArrowLeft") show(at - 1); if (e.key === "ArrowRight") show(at + 1); });
})();
</script>
