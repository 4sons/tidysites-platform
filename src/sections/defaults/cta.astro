---
import { PortableText } from "emdash/ui";
import { bool, buttonClass, buttonsOf, getBusiness, nodeOf, pic, str, wording, rich } from "../lib";
import Photo from "../Photo.astro";
import Action from "../Action.astro";
import Form from "../Form.astro";
const n = nodeOf(Astro.props);
const b = await getBusiness(Astro.request);
const tx = await wording(Astro.request);
const variant = str(n.variant, "band");
const href = str(n.button_url) || b.bookingUrl || "/contact";
const buttons = buttonsOf(n.buttons);
const photo = variant === "band with photo" ? pic(n.image) : null;
---
<section class="ts ts-ink ts-tight" id="book"><div class="ts-wrap" style={variant !== "band" ? "display:grid;grid-template-columns:1.2fr .8fr;gap:32px;align-items:center" : ""}>
	<div>
		<h2>{str(n.headline) || b.ctaLabel}</h2>
		{rich(n.copy).length ? <div class="ts-prose ts-lede"><PortableText value={rich(n.copy) as never} /></div> : str(n.body) && <p class="ts-lede">{str(n.body)}</p>}
		{variant !== "band with email" && <div class="ts-actions">{buttons.length ? buttons.map((x) => <Action class={buttonClass(x.style, "ts-btn-lg")} href={x.url} label={x.label} section="cta" />) : <><Action class="ts-btn ts-btn-accent ts-btn-lg" href={href} label={str(n.button_label) || b.ctaLabel} section="cta" />{str(n.button2_label) ? <Action class="ts-btn ts-btn-outline ts-btn-lg" href={str(n.button2_url, "#")} label={str(n.button2_label)} section="cta" /> : bool(n.show_phone, true) && b.phone && <a class="ts-btn ts-btn-outline ts-btn-lg" href={b.phoneHref}>{b.phone}</a>}</>}</div>}
	</div>
	{photo && (photo.image || photo.url) && <Photo image={photo.image} url={photo.url} alt={str(n.headline) || b.ctaLabel} ratio="wide" class="ts-cta-photo" />}
	{variant === "band with facts" && <dl class="ts-kv ts-card">{b.hours && <><dt>{tx("Hours")}</dt><dd>{b.hours}</dd></>}{b.sameDayLine && <><dt>{tx("Same day")}</dt><dd>{b.sameDayLine}</dd></>}{b.newPatientsLine && <><dt></dt><dd>{b.newPatientsLine}</dd></>}</dl>}
	{variant === "band with email" && <Form name={str(n.form)} class="ts-card ts-form-email" submitLabel={str(n.button_label) || "Subscribe"} emailOnly hidden={{ section: "cta" }} />}
	{variant === "band with form" && (str(n.form) ? <Form name={str(n.form)} class="ts-card" submitLabel={str(n.button_label) || null} hidden={{ section: "cta" }} /> : <form class="ts-form ts-card" action="/api/lead" method="post"><label class="ts-full">{tx("Name")}<input name="name" required /></label><label class="ts-full">{tx("Phone")}<input name="phone" type="tel" /></label><input class="ts-hp" type="text" name="website_hp" tabindex="-1" autocomplete="off" aria-hidden="true" /><div class="ts-full"><button class="ts-btn ts-btn-accent" type="submit">{str(n.button_label) || b.ctaLabel}</button></div></form>)}
</div></section>
