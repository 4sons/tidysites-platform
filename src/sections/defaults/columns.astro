---
/**
 * Columns: any number of slots laid out `across` per row on a laptop, each
 * holding text (markdown), an image, a card, a number, one of the site's
 * forms, a video or the site's own HTML. A slot can span the full row, which
 * is how a section gets its intro and outro. One slot is a band; eight small
 * images across are a logo strip. The look is the section's: a tone or a
 * background photo, the width, the alignment, and a class the site's own CSS
 * can target. A section that continues the one above renders no background
 * of its own; Sections.astro draws the shared one around the run.
 */
import { bool, formDialog, int, list, mediaUrl, nodeOf, pic, str } from "../lib";
import Action from "../Action.astro";
import { markdownToHtml } from "../../lib/markdown";
import { sanitizeHtml } from "../../lib/sanitize";
import { renderCustomHtml } from "../context";
import Form from "../Form.astro";
const n = nodeOf(Astro.props);
const props = Astro.props as { grouped?: boolean; groupTone?: string | null };
const grouped = props.grouped === true;
const across = Math.max(1, int(n.across, 2));
const tone = (grouped && props.groupTone) || str(n.tone, "default");
const bg = grouped ? null : mediaUrl(n.background);
const width = str(n.width, "regular");
const align = str(n.align, "left");
const own = str(n.css_class).replace(/[^a-zA-Z0-9_ -]/g, "").trim();
type Slot = Record<string, unknown>;
const kindOf = (s: Slot) => str(s.kind, "text");
const filled = (s: Slot) => {
	switch (kindOf(s)) {
		case "image": return Boolean(mediaUrl(s.image));
		case "number": return Boolean(str(s.value));
		case "form": return Boolean(str(s.form));
		case "video": return Boolean(str(s.video_url));
		case "html": return Boolean(str(s.html).trim());
		default: return Boolean(str(s.heading) || str(s.text).trim() || mediaUrl(s.image));
	}
};
const slots = list<Slot>(n.slots).map((s, i) => ({ s, i })).filter(({ s }) => filled(s));
const toneClass = tone === "dark" ? "ts-ink" : tone === "light" ? "ts-band" : tone === "accent" ? "ts-ink ts-accent" : "";
const shade = tone === "dark" || tone === "accent";
const style = bg ? `background-image:${shade ? "linear-gradient(rgba(0,0,0,.45),rgba(0,0,0,.6))," : ""}url(${bg})` : undefined;
const prose = (md: string) => sanitizeHtml(markdownToHtml(md));
// An HTML slot reads the records like a custom row does; a form drop-in has no place here (the form slot kind does that).
const htmlSlots = new Map<number, string>();
for (const { s, i } of slots) if (kindOf(s) === "html") htmlSlots.set(i, (await renderCustomHtml(str(s.html), Astro.request)).segments.map((seg) => ("html" in seg ? seg.html : "")).join(""));
const embed = (url: string) => url.replace("watch?v=", "embed/").replace("youtu.be/", "www.youtube.com/embed/").replace("vimeo.com/", "player.vimeo.com/video/");
const full = (s: Slot) => str(s.span) === "full row";
const classes = ["ts", "ts-columns", toneClass, bg ? "ts-has-bg" : "", grouped ? "ts-grouped" : "", bool(n.continue_background) ? "ts-continue" : "", align === "center" ? "ts-center" : "", own].filter(Boolean).join(" ");
---
{slots.length > 0 && (
<section class={classes} style={style}>
	<div class={`ts-wrap ${width === "narrow" ? "ts-narrow" : width === "wide" ? "ts-wide" : ""}`}>
		<div class={`ts-cols ${across >= 4 ? "ts-cols-many" : ""}`} style={`--cols:${across}`}>
			{slots.map(({ s, i: slotIndex }) => {
				const kind = kindOf(s);
				const isFull = full(s);
				const H = isFull ? "h2" : "h3";
				const link = str(s.link_url);
				const img = mediaUrl(s.image);
				const heading = str(s.heading);
				return (
					<div class={`ts-col ts-col-${kind} ${isFull ? "ts-col-full" : ""}`} data-tidy-slot={slotIndex}>
						{kind === "text" && (<>
							{heading && <H>{heading}</H>}
							{str(s.text).trim() && <div class="ts-prose" data-tidy-md={`slots.${slotIndex}.text`} set:html={prose(str(s.text))} />}
							{link && str(s.link_label) && <div class="ts-actions"><Action class={`ts-btn ${shade ? "ts-btn-accent" : ""}`} href={link} label={str(s.link_label)} section="columns" /></div>}
						</>)}
						{kind === "image" && img && (
							<figure class="ts-col-pic">
								{(() => { const alt = pic(s.image).image?.alt || heading || str(s.text); return link ? <a href={link}><img src={img} alt={alt} loading="lazy" /></a> : <img src={img} alt={alt} loading="lazy" />; })()}
								{heading && <figcaption>{heading}</figcaption>}
							</figure>
						)}
						{kind === "card" && (() => { const opensForm = Boolean(formDialog(link)); const Tag = link && !opensForm ? "a" : "div"; return (
							<Tag class="ts-card" href={link && !opensForm ? link : undefined}>
								{img && <img class="ts-col-icon" src={img} alt="" loading="lazy" />}
								{heading && <h3>{heading}</h3>}
								{str(s.text).trim() && <div class="ts-prose" data-tidy-md={`slots.${slotIndex}.text`} set:html={prose(str(s.text))} />}
								{link && str(s.link_label) && (opensForm ? <Action class="ts-btn" href={link} label={str(s.link_label)} section="columns" /> : <span class="ts-card-link">{str(s.link_label)}</span>)}
							</Tag>
						); })()}
						{kind === "number" && <div class="ts-card ts-stat"><b>{str(s.value)}</b>{str(s.label) && <span>{str(s.label)}</span>}</div>}
						{kind === "form" && (<>
							{heading && <H>{heading}</H>}
							{str(s.text).trim() && <div class="ts-prose" style="margin-bottom:16px" data-tidy-md={`slots.${slotIndex}.text`} set:html={prose(str(s.text))} />}
							<Form name={str(s.form)} class="ts-card" hidden={{ section: "columns" }} />
						</>)}
						{kind === "video" && (<>
							{heading && <H>{heading}</H>}
							<div class="ts-video">{/\.(mp4|webm|mov)(\?|$)/i.test(str(s.video_url)) ? <video src={str(s.video_url)} controls playsinline></video> : <iframe src={embed(str(s.video_url))} title={heading || "Video"} loading="lazy" allowfullscreen allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"></iframe>}</div>
						</>)}
						{kind === "html" && <Fragment set:html={htmlSlots.get(slotIndex) ?? ""} />}
					</div>
				);
			})}
		</div>
	</div>
</section>
)}
