---
/** Services or categories from the records, in one of five layouts. */
import { bool, collectionUrl, entries, entryUrl, int, nodeOf, pic, refersTo, str, wording } from "../lib";
import Photo from "../Photo.astro";
import Head from "./_Head.astro";
import Carousel from "./_Carousel.astro";
const tx = await wording(Astro.request);
const n = nodeOf(Astro.props);
const variant = str(n.variant, "cards with summary");
const source = str(n.source, "services");
const limit = int(n.limit, 12);
let items: Array<{ id: string; slug?: string | null; data: Record<string, unknown>; href?: string }> = [];
let groups: Array<{ title: string; items: typeof items }> = [];
const linked = async (col: string, list: Array<{ id: string; slug?: string | null; data: Record<string, unknown> }>) => Promise.all(list.map(async (e) => ({ ...e, href: (await entryUrl(col, e)) ?? undefined })));
const svc = (list: Array<{ id: string; slug?: string | null; data: Record<string, unknown> }>) => linked("services", list);
if (source === "categories") items = await linked("service_categories", await entries("service_categories", { limit }));
else if (source === "featured services") items = await svc(await entries("services", { limit, where: { featured: "1" } }));
else if (source === "services in one category" && str(n.category)) {
	const cats = await entries("service_categories");
	const cat = cats.find((c) => (c.slug ?? c.id) === str(n.category));
	items = await svc(cat ? (await entries("services", { limit: 100 })).filter((s) => refersTo(s.data.category, cat)).slice(0, limit) : []);
} else items = await svc(await entries("services", { limit }));
if (variant === "grouped by category") {
	const cats = await entries("service_categories");
	const all = await svc(await entries("services", { limit: 100 }));
	groups = cats.map((c) => ({ title: str(c.data.title), items: all.filter((s) => refersTo(s.data.category, c)) })).filter((g) => g.items.length);
	if (!groups.length) groups = [{ title: "", items: all }];
}
const showAll = bool(n.show_all, true);
const allHref = await collectionUrl("services");
---
{(items.length > 0 || groups.length > 0) && (
<section class="ts ts-band" id="services"><div class="ts-wrap">
	<Head n={n} action={showAll && allHref ? { href: allHref, label: tx("All services") } : null} />
	{variant === "carousel" ? (
		<Carousel cols={3} label="Services">{items.map((s) => { const p = pic(s.data.featured_image); return (
			<a class="ts-card ts-carousel-item" href={s.href} data-tidy-record={source === "categories" ? "service_categories" : "services"} data-tidy-record-id={s.id} data-tidy-record-label={source === "categories" ? "Category details" : "Service details"}>
				{(p.image || p.url) && <Photo image={p.image} url={p.url} alt={str(s.data.title)} ratio="wide" />}
				<h3>{str(s.data.title)}</h3>
				{str(s.data.summary) && <p>{str(s.data.summary)}</p>}
			</a>
		); })}</Carousel>
	) : variant === "checklist" ? (
		<ul class="ts-list" style="columns:2;gap:28px">{items.map((s) => <li><a href={s.href}>{str(s.data.title)}</a></li>)}</ul>
	) : variant === "grouped by category" ? (
		groups.map((g) => <div>{g.title && <p class="ts-group">{g.title}</p>}<div class="ts-chips">{g.items.map((s) => <a class="ts-chip" href={s.href} data-tidy-record="services" data-tidy-record-id={s.id} data-tidy-record-label="Service details">{str(s.data.title)}</a>)}</div></div>)
	) : (
		<div class="ts-grid" style={`--cols:${variant === "image tiles" ? 3 : 3}`}>
			{items.map((s) => (
				<a class="ts-card" href={s.href} data-tidy-record={source === "categories" ? "service_categories" : "services"} data-tidy-record-id={s.id} data-tidy-record-label={source === "categories" ? "Category details" : "Service details"}>
					{variant === "image tiles" && (() => { const p = pic(s.data.featured_image); return <Photo image={p.image} url={p.url} alt={str(s.data.title)} ratio="wide" />; })()}
					{variant === "icon cards" && str(s.data.icon) && <span class="ts-eyebrow" style="margin:0">{str(s.data.icon)}</span>}
					<h3>{str(s.data.title)}</h3>
					{variant !== "image tiles" && str(s.data.summary) && <p>{str(s.data.summary)}</p>}
					{str(s.data.price_from) && <p class="ts-muted" style="font-size:13px">From {str(s.data.price_from)}</p>}
				</a>
			))}
		</div>
	)}
</div></section>
)}
