---
/** Questions from the records, filtered by group or service, plus any written into the section. */
import { bool, entries, int, list, nodeOf, str } from "../lib";
import Head from "./_Head.astro";
const n = nodeOf(Astro.props);
const group = str(n.group);
let items = await entries("faqs", { limit: int(n.limit, 40), ...(group ? { where: { group } } : {}) });
const extra = list<Record<string, unknown>>(n.items).filter((q) => str(q.question));
const grouped = bool(n.grouped) && !group;
const groups = grouped ? [...new Set(items.map((q) => str(q.data.group)))].map((g) => ({ title: g, items: items.filter((q) => str(q.data.group) === g) })) : [{ title: "", items }];
---
{(items.length > 0 || extra.length > 0) && (
<section class="ts ts-band" id="faq"><div class="ts-wrap">
	<Head n={n} />
	<div style="max-width:820px">
		{groups.map((g) => <div>{g.title && <p class="ts-group">{g.title}</p>}{g.items.map((q) => <details data-tidy-record="faqs" data-tidy-record-id={q.id} data-tidy-record-label="Question"><summary>{str(q.data.title)}</summary><div class="ts-a">{str(q.data.answer)}</div></details>)}</div>)}
		{extra.map((q) => <details><summary>{str(q.question)}</summary><div class="ts-a">{str(q.answer)}</div></details>)}
	</div>
</div></section>
)}
