---
import { bool, entries, int, nodeOf, pic, str } from "../lib";
import Photo from "../Photo.astro";
import Head from "./_Head.astro";
const n = nodeOf(Astro.props);
const items = await entries("technologies", { limit: int(n.limit, 6) });
---
{items.length > 0 && (
<section class="ts ts-band"><div class="ts-wrap">
	<Head n={n} />
	<div class="ts-grid" style="--cols:3">{items.map((t) => { const p = pic(t.data.image); return <div class="ts-card" data-tidy-record="technologies" data-tidy-record-id={t.id} data-tidy-record-label="Technology">{(p.image || p.url) && <Photo image={p.image} url={p.url} alt={str(t.data.title)} ratio="wide" />}<h3>{str(t.data.title)}{str(t.data.brand) && <span class="ts-muted" style="font-weight:400;font-size:14px"> · {str(t.data.brand)}</span>}</h3>{str(t.data.summary) && <p>{str(t.data.summary)}</p>}{bool(t.data.has_page) && <a href={`/technology/${t.slug ?? t.id}`} style="font-weight:700;color:var(--ts-primary);font-size:14px">Learn more</a>}</div>; })}</div>
</div></section>
)}
