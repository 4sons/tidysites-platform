---
/** Associations, certifications, awards and seals: from the badge records or written into the section. */
import { entries, list, nodeOf, pic, str } from "../lib";
import Head from "./_Head.astro";
const n = nodeOf(Astro.props);
const fromRecords = str(n.source, "badges from the badges records").startsWith("badges from");
const group = str(n.group);
const recs = fromRecords ? (await entries("badges", { limit: 24 })).filter((b) => !group || str(b.data.group) === group).map((b) => ({ title: str(b.data.title), issuer: str(b.data.issuer), image: pic(b.data.image), url: str(b.data.url), id: b.id })) : [];
const inline = list<Record<string, unknown>>(n.badges).map((b) => ({ title: str(b.title), issuer: str(b.issuer), image: pic(b.image), url: str(b.url), id: "" }));
const items = [...recs, ...inline].filter((b) => b.title);
---
{items.length > 0 && (
<section class="ts ts-tight"><div class="ts-wrap">
	<Head n={n} />
	<div class="ts-logos">{items.map((b) => { const Tag = b.url ? "a" : "div"; return <Tag class="ts-logo" href={b.url || undefined} {...(b.id ? { "data-tidy-record": "badges", "data-tidy-record-id": b.id, "data-tidy-record-label": "Badge" } : {})}>{(b.image.image?.src || b.image.url) && <img src={b.image.image?.src ?? b.image.url ?? ""} alt="" />}<span>{b.title}{b.issuer && <span class="ts-muted" style="font-weight:400"> · {b.issuer}</span>}</span></Tag>; })}</div>
</div></section>
)}
