---
/** One of the site's forms as a section: on its own, in a card, or beside the business details. */
import { bool, getBusiness, nodeOf, str, addressLine, wording } from "../lib";
import Head from "./_Head.astro";
import Form from "../Form.astro";
const n = nodeOf(Astro.props);
const b = await getBusiness(Astro.request);
const tx = await wording(Astro.request);
const variant = str(n.variant, "card");
const beside = variant === "beside business details";
---
<section class="ts" id="form"><div class="ts-wrap">
	<Head n={n} />
	<div class={beside ? "ts-split" : ""} style={beside ? "align-items:start" : "max-width:720px"}>
		<Form name={str(n.form)} submitLabel={str(n.submit_label) || null} class={variant === "plain" ? "" : "ts-card"} hidden={{ section: str(n.headline) }} />
		{beside && (
			<dl class="ts-kv ts-card">
				{b.phone && <><dt>{tx("Call or text")}</dt><dd><a href={b.phoneHref}>{b.phone}</a></dd></>}
				{b.email && <><dt>{tx("Email")}</dt><dd><a href={`mailto:${b.email}`}>{b.email}</a></dd></>}
				{b.hours && <><dt>{tx("Hours")}</dt><dd>{b.hours}</dd></>}
				{addressLine(b) && <><dt>{b.isServiceArea ? tx("Based in") : tx("Address")}</dt><dd>{addressLine(b)}</dd></>}
				{bool(n.show_parking) && b.parkingLine && <><dt>{tx("Parking")}</dt><dd>{b.parkingLine}</dd></>}
			</dl>
		)}
	</div>
</div></section>
