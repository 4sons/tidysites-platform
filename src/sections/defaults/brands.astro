---
import { entries, nodeOf, pic, str } from "../lib";
import Head from "./_Head.astro";
const n = nodeOf(Astro.props);
let items = await entries("brands", { limit: 40 });
if (str(n.group)) items = items.filter((b) => str(b.data.group) === str(n.group));
const names = str(n.variant) === "names";
---
{items.length > 0 && (
<section class="ts ts-tight"><div class="ts-wrap">
	<Head n={n} />
	{names ? <p class="ts-lede" style="margin:0">{items.map((b) => str(b.data.title)).join(", ")}</p> : <div class="ts-logos">{items.map((b) => { const p = pic(b.data.logo); const Tag = str(b.data.url) ? "a" : "div"; return <Tag class="ts-logo" href={str(b.data.url) || undefined} data-tidy-record="brands" data-tidy-record-id={b.id} data-tidy-record-label="Brand">{(p.image?.src || p.url) && <img src={p.image?.src ?? p.url ?? ""} alt="" />}<span>{str(b.data.title)}</span></Tag>; })}</div>}
</div></section>
)}
