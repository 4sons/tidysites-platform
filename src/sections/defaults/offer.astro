---
import { bool, entries, nodeOf, str, wording } from "../lib";
const tx = await wording(Astro.request);
const n = nodeOf(Astro.props);
const offers = await entries("offers", { limit: 20 });
const want = str(n.offer);
const o = (want ? offers.find((x) => (x.slug ?? x.id) === want) : offers.find((x) => bool(x.data.active, true))) ?? null;
const ends = o ? str(o.data.ends) : "";
const live = !o || !ends || new Date(ends).getTime() > Date.now();
const title = str(n.headline) || (o ? str(o.data.title) : "");
---
{title && live && (
<section class="ts ts-tight"><div class="ts-wrap">
	<div class="ts-offer" {...(o ? { "data-tidy-record": "offers", "data-tidy-record-id": o.id, "data-tidy-record-label": "Offer" } : {})}>
		<div>{ends && <p class="ts-eyebrow">Until {new Date(ends).toLocaleDateString("en-CA", { month: "long", day: "numeric" })}</p>}<h3 style="font-size:24px">{title}{o && str(o.data.value) ? ` · ${str(o.data.value)}` : ""}</h3>{(str(n.body) || (o && str(o.data.summary))) && <p style="margin-top:6px;color:var(--ts-ink-2)">{str(n.body) || str(o!.data.summary)}</p>}{o && str(o.data.how_to_claim) && <p class="ts-muted" style="font-size:13px;margin-top:6px">{str(o.data.how_to_claim)}</p>}</div>
		<a class="ts-btn ts-btn-accent ts-btn-lg" href={str(n.button_url) || (o && str(o.data.cta_url)) || "/contact"}>{str(n.button_label) || (o && str(o.data.cta_label)) || tx("Claim this offer")}</a>
	</div>
</div></section>
)}
