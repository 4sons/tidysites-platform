---
/** Financing providers and payment methods. Providers written in the section; the financing provider records when the section has none. */
import { bool, entries, getBusiness, list, nodeOf, pic, str, mediaUrl, wording, type Entry } from "../lib";
import Head from "./_Head.astro";
const n = nodeOf(Astro.props);
const b = await getBusiness(Astro.request);
const tx = await wording(Astro.request);
const own = list<Record<string, unknown>>(n.items).filter((i) => str(i.title) || mediaUrl(i.logo));
const providers: Entry[] = own.length ? own.map((data, i) => ({ id: "", slug: `item-${i}`, data })) : bool(n.show_providers, true) ? await entries("financing_providers", { limit: 8 }) : [];
const methods = str(n.payment_methods).split(",").map((s) => s.trim()).filter(Boolean);
const rec = (p: Entry) => (p.id ? { "data-tidy-record": "financing_providers", "data-tidy-record-id": p.id, "data-tidy-record-label": "Financing provider" } : {});
---
{(providers.length > 0 || methods.length > 0 || b.hsaFsaLine) && (
<section class="ts ts-band" id="financing"><div class="ts-wrap">
	<Head n={n} action={bool(n.show_plans) ? { href: "/plans", label: tx("Membership plans") } : null} />
	<div class="ts-grid" style="--cols:3">
		{providers.map((p) => { const lg = pic(p.data.logo); return <div class="ts-card" {...rec(p)}>{mediaUrl(lg) && <img src={mediaUrl(lg) ?? ""} alt="" style="max-height:28px;width:auto" />}<h3>{str(p.data.title)}</h3>{str(p.data.rate_line) && <p>{str(p.data.rate_line)}</p>}{str(p.data.note) && <p class="ts-muted" style="font-size:13px">{str(p.data.note)}</p>}{str(p.data.apply_url) && <a href={str(p.data.apply_url)} style="font-weight:700;color:var(--ts-primary);font-size:14px">{tx("Check your options")}</a>}</div>; })}
		{(methods.length > 0 || (bool(n.show_hsa, true) && b.hsaFsaLine)) && <div class="ts-card"><h3>{tx("Paying directly")}</h3>{methods.length > 0 && <p>{methods.join(", ")}</p>}{bool(n.show_hsa, true) && b.hsaFsaLine && <p class="ts-muted" style="font-size:13px">{b.hsaFsaLine}</p>}</div>}
	</div>
</div></section>
)}
