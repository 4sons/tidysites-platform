---
import { PortableText } from "emdash/ui";
import { nodeOf, pic, str, rich } from "../lib";
import Photo from "../Photo.astro";
const n = nodeOf(Astro.props);
const photo = pic(n.image);
const has = Boolean(photo.image || photo.url);
---
<section class="ts"><div class={`ts-wrap ${has ? "ts-split" : ""}`}>
	<div>{str(n.eyebrow) && <p class="ts-eyebrow">{str(n.eyebrow)}</p>}{str(n.headline) && <h2>{str(n.headline)}</h2>}{rich(n.copy).length ? <div class="ts-prose" style="margin-top:14px"><PortableText value={rich(n.copy) as never} /></div> : str(n.body) && <div class="ts-prose" style="margin-top:14px;white-space:pre-line">{str(n.body)}</div>}{str(n.button_label) && <div class="ts-actions"><a class="ts-btn" href={str(n.button_url, "#")}>{str(n.button_label)}</a></div>}</div>
	{has && <Photo image={photo.image} url={photo.url} alt={str(n.headline)} />}
</div></section>
