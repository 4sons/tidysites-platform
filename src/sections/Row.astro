---
/**
 * A custom row: HTML and CSS written by a person or an agent, rendered as
 * part of the page through the sanitizer (nothing runs) with its CSS scoped
 * to the row. By a saved row's name, or inline. Used by the `row` section and
 * in place of the header or footer. The markup may read the site's records
 * ({{ business.phone }}, {{#each services}}, {{> menu}}; see lib/template),
 * so a custom header or footer is as live as the frame's own.
 */
import { getRow, str } from "./lib";
import { scopeCss } from "../lib/sanitize";
import { renderCustomHtml } from "./context";
import { responsiveImgs } from "../lib/images";
import Form from "./Form.astro";
import Dialog from "../frame/Dialog.astro";
import "./defaults.css";
interface Props { name?: string | null; html?: string | null; css?: string | null; blockKey?: string | null; fullWidth?: boolean; as?: "header" | "footer" | "section"; /** The row's place on the page: the first section and the header load their pictures at once, the rest lazily. */ index?: number }
const { name = "", html: inlineHtml = "", css: inlineCss = "", blockKey = null, fullWidth = false, as = "section", index = 0 } = Astro.props;
const row = name ? await getRow(name) : null;
const html = row ? str(row.data.html) : (inlineHtml ?? "");
const css = row ? str(row.data.css) : (inlineCss ?? "");
const key = (blockKey || row?.slug || row?.id || "inline").replace(/[^A-Za-z0-9_-]/g, "");
const rendered = await renderCustomHtml(html, Astro.request);
// A picture below the first screen loads when it is needed, unless the markup says otherwise.
const belowFold = as === "footer" || (as === "section" && index > 0);
const lazy = (h: string) => (belowFold ? h.replace(/<img\b(?![^>]*\bloading=)([^>]*)>/gi, '<img loading="lazy" decoding="async"$1>') : h);
// The first picture of the first section is usually the largest thing on the first screen; ask for it first.
let priorityLeft = as === "section" && index === 0;
const priority = (h: string) => (priorityLeft ? h.replace(/<img\b(?![^>]*\bfetchpriority=)([^>]*)>/i, (m, attrs: string) => { priorityLeft = false; return `<img fetchpriority="high"${attrs}>`; }) : h);
const pictures = (h: string) => priority(lazy(responsiveImgs(h)));
const scoped = css ? scopeCss(css, `.ts-row[data-row="${key}"]`) : "";
const Tag = as === "header" ? "header" : as === "footer" ? "footer" : "div";
const hasContent = rendered.segments.some((s) => ("html" in s ? s.html.trim() !== "" : true));
// One dialog per form per page, however many rows and buttons open it.
const seen = ((Astro.locals as unknown as { tidyFormDialogs?: Set<string> }).tidyFormDialogs ??= new Set<string>());
const dialogs = rendered.dialogs.filter((d) => !seen.has(d.id));
for (const d of dialogs) seen.add(d.id);
---
{hasContent && (
	<Tag class={`ts-row ts-row-${as} ${fullWidth ? "ts-row-full" : ""}`} data-row={key} data-tidy-frame={as === "header" || as === "footer" ? as : undefined} data-tidy-row={row ? (row.slug ?? row.id) : undefined} {...(row ? { "data-tidy-record": "rows", "data-tidy-record-id": row.id, "data-tidy-record-label": "Custom row" } : {})}>
		{scoped && <style set:html={scoped} />}
		<div class={fullWidth ? "" : "ts-row-wrap"}>
			{rendered.segments.map((s) => ("html" in s ? <Fragment set:html={pictures(s.html)} /> : <Form name={s.form} class="ts-card" hidden={{ section: "row" }} />))}
		</div>
		{import.meta.env.DEV && rendered.error && <p class="ts-missing" role="alert">{rendered.error}</p>}
	</Tag>
)}
{dialogs.map((d) => <Dialog id={d.id} title={d.name} class="ts-form-dialog"><Form name={d.name} hidden={{ section: "row" }} /></Dialog>)}
