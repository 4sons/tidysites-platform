---
/**
 * The Turnstile widget for a form, with its script loaded only when it is
 * about to be needed: when the widget comes within a screen of view, when a
 * field of the form takes focus, or when a button that opens a form dialog
 * is pressed. The script and its challenge weigh more than the rest of a
 * page put together, and a contact form in a dialog or at the foot of the
 * page would otherwise charge every visit for it up front.
 */
interface Props { sitekey: string }
const { sitekey } = Astro.props;
---
<div class="cf-turnstile ts-full" data-sitekey={sitekey} data-size="flexible" data-appearance="interaction-only"></div>
<script is:inline>
(function () {
	if (window.__tidyTurnstile) return; window.__tidyTurnstile = true;
	var loaded = false;
	function load() {
		if (loaded) return; loaded = true;
		var s = document.createElement("script"); s.src = "https://challenges.cloudflare.com/turnstile/v0/api.js"; s.async = true; s.defer = true;
		document.head.appendChild(s);
	}
	function start() {
		var widgets = document.querySelectorAll(".cf-turnstile");
		if (!widgets.length) return;
		if (!("IntersectionObserver" in window)) { load(); return; }
		var io = new IntersectionObserver(function (es) { for (var i = 0; i < es.length; i++) if (es[i].isIntersecting) { load(); io.disconnect(); return; } }, { rootMargin: "600px" });
		widgets.forEach(function (w) { io.observe(w); });
	}
	document.addEventListener("focusin", function (e) { var t = e.target; if (t && t.closest && t.closest("form")) load(); }, true);
	document.addEventListener("pointerdown", function (e) { var t = e.target; if (t && t.closest && t.closest("[data-tidy-dialog], form")) load(); }, true);
	if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", start); else start();
})();
</script>
