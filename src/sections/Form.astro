---
/**
 * A form from the site's `forms` collection, or the built-in contact form
 * when none is named. Renders the contact fields the form asks for, then its
 * questions, posts to /api/lead with every answer under `fields`, and shows
 * the form's thank-you in place. Any theme section, the header dialog or a
 * site's own page can place it: <Form name="Schedule a make up" />.
 */
import Turnstile from "./Turnstile.astro";
import { botCheckOf, signBotCheck, turnstileAppearance } from "../lib/botcheck";
import { getForm, list, lines, str, bool, type FormRecord, wording } from "./lib";
const tx = await wording(Astro.request);
interface Props {
	/** The form's name, slug or id. Empty renders the default contact form. */
	name?: string | null;
	/** Overrides the form's own button label. */
	submitLabel?: string | null;
	/** Extra classes on the <form>; `ts-card` frames it. */
	class?: string;
	/** Fields to post along with the answers, for example which page or section sent it. */
	hidden?: Record<string, string>;
	/** Ask for an email and nothing else (a newsletter band); the form record's own setting wins when it names one. */
	emailOnly?: boolean;
}
const { name = "", submitLabel = null, class: cls = "", hidden = {}, emailOnly = false } = Astro.props;
const form: FormRecord | null = name ? await getForm(name) : null;
const d = form?.data ?? {};
const contact = str(d.contact_fields, emailOnly ? "email only" : "name, phone and email");
const onlyEmail = contact === "email only";
// "none": the form asks its questions and nothing else, so a form whose boxes come in the old site's own order (first name, last name, country, ...) is written as questions.
const noContact = contact.startsWith("none");
const askPhone = !noContact && contact.includes("phone"), askEmail = !noContact && contact.includes("email");
// The contact boxes take the form's own labels and hints, and can follow the questions instead of leading them.
const nameLabel = str(d.name_label) || tx("Name"), phoneLabel = str(d.phone_label) || tx("Phone"), emailLabel = str(d.email_label) || tx("Email");
const nameHint = str(d.name_placeholder) || undefined, phoneHint = str(d.phone_placeholder) || undefined, emailHint = str(d.email_placeholder) || undefined;
const contactAfter = str(d.contact_fields_position) === "after the questions";
const markRequired = bool(d.mark_required);
const req = (required: boolean, cls = "") => `${cls} ${markRequired && required ? "ts-required" : ""}`.trim() || undefined;
type Q = { label: string; kind: string; options: string; required: boolean; placeholder: string };
const questions: Q[] = onlyEmail && !form
	? []
	: form
	? list<Record<string, unknown>>(d.questions).map((q) => ({ label: str(q.label), kind: str(q.kind, "short answer"), options: str(q.options), required: bool(q.required), placeholder: str(q.placeholder) })).filter((q) => q.label)
	: [{ label: tx("How can we help?"), kind: "long answer", options: "", required: false, placeholder: "" }];
const submit = submitLabel || str(d.submit_label) || (onlyEmail ? tx("Subscribe") : tx("Send"));
const doneTitle = str(d.success_title) || "Thank you";
const doneText = str(d.success_message) || "We have your message and will be in touch soon.";
const consent = str(d.consent_text);
const intro = str(d.intro);
const slugOf = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, "_").replace(/^_+|_+$/g, "").slice(0, 60) || "answer";
const formName = form?.title || (onlyEmail ? tx("Newsletter") : tx("Contact"));
// The form's check: the hidden trap field always, Turnstile when the form asks for it and the site has a widget. The choice travels to the lead route as a signed token.
const check = botCheckOf(d.bot_check);
let sitekey: string | undefined, secret: string | undefined;
try { const m = (await import("cloudflare:workers")) as unknown as { env?: Record<string, unknown> }; sitekey = typeof m.env?.TURNSTILE_SITEKEY === "string" ? m.env.TURNSTILE_SITEKEY : undefined; secret = typeof m.env?.TURNSTILE_SECRET === "string" ? m.env.TURNSTILE_SECRET : undefined; } catch { sitekey = undefined; secret = undefined; }
const turnstile = check === "turnstile" && sitekey && secret ? sitekey : undefined;
const appearance = turnstileAppearance(d.bot_check);
const botCheck = secret ? await signBotCheck(secret, formName, turnstile ? "turnstile" : "trap") : null;
---
<form class={`ts-form ${cls}`} action="/api/lead" method="post" data-tidy-form={form?.slug ?? form?.id ?? "contact"} data-error={tx("Something went wrong. Please try again.")}>
	<div class="ts-form-fields">
		{intro && <p class="ts-form-intro">{intro}</p>}
		{!contactAfter && <>
			{!onlyEmail && !noContact && <label class={req(true, askPhone && askEmail ? "ts-full" : "")}>{nameLabel}<input name="name" autocomplete="name" required placeholder={nameHint} /></label>}
			{askPhone && <label class={req(!askEmail)}>{phoneLabel}<input name="phone" type="tel" autocomplete="tel" required={!askEmail} placeholder={phoneHint} /></label>}
			{askEmail && <label class={req(!askPhone)}>{emailLabel}<input name="email" type="email" autocomplete="email" required={!askPhone} placeholder={emailHint} /></label>}
		</>}
		{questions.map((q, i) => {
			const key = `q_${slugOf(q.label)}`;
			const opts = lines(q.options);
			if (q.kind === "long answer") return <label class={req(q.required, "ts-full")}>{q.label}<textarea name={key} required={q.required} placeholder={q.placeholder || undefined}></textarea></label>;
			if (q.kind === "one choice" && opts.length) return <label class={req(q.required, "ts-full")}>{q.label}<select name={key} required={q.required}><option value="">{q.placeholder || tx("Choose one")}</option>{opts.map((o) => <option>{o}</option>)}</select></label>;
			if (q.kind === "several choices" && opts.length) return <div class="ts-full"><span style="font-size:13px;font-weight:600;color:var(--ts-ink-2);display:block;margin-bottom:8px">{q.label}</span><div class="ts-choices">{opts.map((o) => <label><input type="checkbox" name={key} value={o} />{o}</label>)}</div></div>;
			if (q.kind === "date") return <label class={req(q.required)}>{q.label}<input name={key} type="date" required={q.required} /></label>;
			if (q.kind === "number") return <label class={req(q.required)}>{q.label}<input name={key} type="number" inputmode="numeric" required={q.required} placeholder={q.placeholder || undefined} /></label>;
			if (q.kind === "file upload") return <label class={req(q.required, "ts-full")}>{q.label}<input name={key} type="file" required={q.required} accept=".pdf,.doc,.docx,.txt,.rtf,.jpg,.jpeg,.png,.gif,.webp,.heic" /></label>;
			return <label class={req(q.required, i === questions.length - 1 && questions.length % 2 ? "ts-full" : "")}>{q.label}<input name={key} required={q.required} placeholder={q.placeholder || undefined} /></label>;
		})}
		{contactAfter && <>
			{!onlyEmail && !noContact && <label class={req(true, askPhone && askEmail ? "ts-full" : "")}>{nameLabel}<input name="name" autocomplete="name" required placeholder={nameHint} /></label>}
			{askPhone && <label class={req(!askEmail)}>{phoneLabel}<input name="phone" type="tel" autocomplete="tel" required={!askEmail} placeholder={phoneHint} /></label>}
			{askEmail && <label class={req(!askPhone)}>{emailLabel}<input name="email" type="email" autocomplete="email" required={!askPhone} placeholder={emailHint} /></label>}
		</>}
		{questions.map((q) => <input type="hidden" name={`label:q_${slugOf(q.label)}`} value={q.label} />)}
		<input type="hidden" name="form" value={formName} />
		{Object.entries(hidden).map(([k, v]) => <input type="hidden" name={k} value={v} />)}
		<input class="ts-hp" type="text" name="website_hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
		{botCheck && <input type="hidden" name="bot_check" value={botCheck} />}
		{turnstile && <Turnstile sitekey={turnstile} appearance={appearance} />}
		<p class="ts-form-error" role="alert"></p>
		<div class="ts-full" style="display:flex;gap:14px;align-items:center;flex-wrap:wrap"><button class="ts-btn ts-btn-accent" type="submit">{submit}</button></div>
		{consent && <p class="ts-consent">{consent}</p>}
	</div>
	<div class="ts-form-done" aria-live="polite"><h3>{doneTitle}</h3><p>{doneText}</p></div>
</form>
<script is:inline>
(function(){
	if (window.__tidyForms) return; window.__tidyForms = true;
	document.addEventListener("submit", async function (e) {
		var f = e.target; if (!(f instanceof HTMLFormElement) || !f.hasAttribute("data-tidy-form")) return;
		e.preventDefault();
		var fallback = f.getAttribute("data-error") || "Something went wrong. Please try again.";
		var btn = f.querySelector('button[type="submit"]'); var err = f.querySelector(".ts-form-error");
		if (btn) btn.disabled = true; if (err) err.textContent = "";
		try {
			var r = await fetch(f.action, { method: "POST", body: new FormData(f), headers: { accept: "application/json" } });
			var j = await r.json().catch(function () { return {}; });
			if (!r.ok || j.ok === false) throw new Error(j.error || fallback);
			f.setAttribute("data-done", "");
			f.dispatchEvent(new CustomEvent("tidy:lead", { bubbles: true }));
		} catch (x) { if (err) err.textContent = x && x.message ? x.message : fallback; }
		if (btn) btn.disabled = false;
	});
})();
</script>
