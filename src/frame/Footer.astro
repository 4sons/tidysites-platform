---
/**
 * The site footer: brand and tagline with the social links, a column of
 * services, the footer menu, the visit details, and the legal line. Classes
 * from the frame contract (ts-footer-*).
 */
import type { Business } from "../sections/lib";
import { addressLine, entries, entryUrl, getLocation, hoursRows, mediaUrl, wording } from "../sections/lib";
import type { MenuItem } from "./Header.astro";
import Row from "../sections/Row.astro";
import "../sections/defaults.css";
import "./frame.css";
const tx = await wording(Astro.request);
interface Props {
	business: Business;
	menu?: { items: MenuItem[] } | null;
	footerMenu?: { items: MenuItem[] } | null;
	siteTitle?: string;
	/** Heading over the footer menu's column. */
	footerMenuLabel?: string;
	/** How many services to list; 0 leaves the column out. */
	services?: number;
	class?: string;
}
const { business: b, footerMenu = null, siteTitle = b.title, footerMenuLabel: menuLabelDefault = "More", services: count = 6, class: cls = "" } = Astro.props;
// The frame record's headings win over the theme's defaults; its switch can drop the services column.
const services = count > 0 && b.footerServices ? await entries("services", { limit: count }) : [];
const serviceLinks = new Map(await Promise.all(services.map(async (s) => [s.id, await entryUrl("services", s)] as const)));
const servicesLabel = b.footerServicesLabel || "Services";
const footerMenuLabel = b.footerMenuLabel || menuLabelDefault;
const loc = await getLocation();
const hours = loc ? hoursRows(loc.data) : [];
const logo = b.logo ? mediaUrl(b.logo) ?? b.logo.src : null;
const initial = siteTitle.trim().charAt(0).toUpperCase();
const year = new Date().getFullYear();
---
{b.footerRow ? <Row name={b.footerRow} as="footer" fullWidth /> : (
<footer class={`ts-frame ts-footer ${cls}`} data-tidy-frame="footer">
	<div class="ts-footer-wrap">
		<div class="ts-footer-brand">
			<a class="ts-brand" href="/">{logo ? <img class="ts-brand-logo" src={logo} alt={b.logo?.alt || siteTitle} /> : <><span class="ts-brand-mark">{initial}</span><span class="ts-brand-name">{siteTitle}</span></>}</a>
			{b.tagline && <p class="ts-footer-tagline">{b.tagline}</p>}
			{b.social.length > 0 && <div class="ts-footer-social">{b.social.map((s) => <a class="ts-footer-social-link" href={s.url} aria-label={s.network} target="_blank" rel="noopener">{s.network.charAt(0).toUpperCase()}</a>)}</div>}
		</div>
		{services.length > 0 && <div class="ts-footer-col"><h4 class="ts-footer-heading">{servicesLabel}</h4><ul class="ts-footer-list">{services.map((s) => <li><a href={serviceLinks.get(s.id) ?? undefined}>{String(s.data.title)}</a></li>)}</ul></div>}
		{footerMenu?.items.length ? <div class="ts-footer-col"><h4 class="ts-footer-heading">{footerMenuLabel}</h4><ul class="ts-footer-list">{footerMenu.items.map((i) => <li><a href={i.url} target={i.target}>{i.label}</a></li>)}</ul></div> : <div class="ts-footer-col"></div>}
		<div class="ts-footer-col ts-footer-visit"><h4 class="ts-footer-heading">{tx("Visit")}</h4><ul class="ts-footer-list">
			{addressLine(b) && <li>{addressLine(b)}</li>}
			{b.phone && <li><a href={b.phoneHref}>{b.phone}</a></li>}
			{b.email && <li><a href={`mailto:${b.email}`}>{b.email}</a></li>}
			{hours.length > 0 ? <li class="ts-footer-hours"><table class="ts-hours ts-hours-small"><tbody>{hours.map((r) => <tr><th scope="row">{r.day.slice(0, 3)}</th><td>{r.value}</td></tr>)}</tbody></table></li> : b.hours && <li class="ts-footer-hours">{b.hours}</li>}
		</ul></div>
		<div class="ts-footer-legal">
			<span>© {year} {siteTitle}{b.licenseLine ? ` · ${b.licenseLine}` : ""}</span>
			<span>{b.accessibilityLine && <>{b.accessibilityLine} · </>}<a href="/privacy">{tx("Privacy")}</a></span>
		</div>
	</div>
</footer>
)}
