{
	"name": "@tideworthy/tidysites-platform",
	"version": "0.30.10",
	"description": "The Tidysites platform integration for EmDash sites: bootstrap, sessions, maintenance, health, and publish hooks under /_tidy/*.",
	"license": "MIT",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "https://github.com/4sons/tidysites-platform.git"
	},
	"homepage": "https://github.com/4sons/tidysites-platform#readme",
	"files": [
		"src",
		"template",
		"bin",
		"README.md",
		"LICENSE",
		"CHANGELOG.md"
	],
	"exports": {
		".": "./src/index.ts",
		"./plugin": "./src/plugin.ts",
		"./middleware": "./src/middleware.ts",
		"./editor": "./src/editor/TidyEditor.astro",
		"./editor/ops": "./src/editor/ops.ts",
		"./client": "./src/client.ts",
		"./routes/bootstrap": "./src/routes/bootstrap.ts",
		"./routes/session": "./src/routes/session.ts",
		"./routes/session-claim": "./src/routes/session-claim.ts",
		"./routes/edit": "./src/routes/edit.ts",
		"./routes/health": "./src/routes/health.ts",
		"./routes/rotate-token": "./src/routes/rotate-token.ts",
		"./routes/fill": "./src/routes/fill.ts",
		"./routes/schema": "./src/routes/schema.ts",
		"./routes/maintenance": "./src/routes/maintenance.ts",
		"./routes/revisions": "./src/routes/revisions.ts",
		"./routes/change": "./src/routes/change.ts",
		"./routes/pages": "./src/routes/pages.ts",
		"./routes/strings": "./src/routes/strings.ts",
		"./routes/lead-file": "./src/routes/lead-file.ts",
		"./strings": "./src/lib/strings.ts",
		"./production": "./src/production.ts",
		"./routes-lib": "./src/lib/routes.ts",
		"./seo": "./src/lib/seo.ts",
		"./template": "./src/template/index.ts",
		"./template/structure.json": "./template/structure.json",
		"./sections": "./src/sections/Sections.astro",
		"./sections/lib": "./src/sections/lib.ts",
		"./sections/photo": "./src/sections/Photo.astro",
		"./sections/defaults.css": "./src/sections/defaults.css",
		"./sections/defaults/*": "./src/sections/defaults/*",
		"./lead": "./src/lib/lead.ts",
		"./frame/header": "./src/frame/Header.astro",
		"./frame/footer": "./src/frame/Footer.astro",
		"./frame/dialog": "./src/frame/Dialog.astro",
		"./frame/frame.css": "./src/frame/frame.css",
		"./sections/form": "./src/sections/Form.astro",
		"./frame/scripts": "./src/frame/Scripts.astro",
		"./sections/row": "./src/sections/Row.astro",
		"./sanitize": "./src/lib/sanitize.ts",
		"./frame/fonts": "./src/frame/Fonts.astro",
		"./frame/consent": "./src/frame/Consent.astro",
		"./routes/gallery": "./src/routes/gallery.astro",
		"./editor/targets": "./src/editor/targets.ts",
		"./sections/action": "./src/sections/Action.astro",
		"./routes/img": "./src/routes/img.ts",
		"./images": "./src/lib/images.ts"
	},
	"scripts": {
		"typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.editor.json",
		"test": "vitest run",
		"check": "npm run typecheck && npm run test && npm run check:cli",
		"check:cli": "cd cli && npm run check"
	},
	"peerDependencies": {
		"@emdash-cms/auth": ">=1.0.0 <2.0.0",
		"astro": "^7.0.0",
		"emdash": ">=1.0.0 <2.0.0",
		"kysely": ">=0.29.0"
	},
	"devDependencies": {
		"@astrojs/react": "^6.0.0",
		"@cloudflare/workers-types": "^5.20260915.1",
		"@emdash-cms/auth": "1.0.1",
		"@emdash-cms/auth-atproto": ">=0.2.8",
		"astro": "^7.3.2",
		"emdash": "^1.3.1",
		"kysely": "^0.29.0",
		"react": "19.2.4",
		"react-dom": "19.2.4",
		"typescript": "^5.9.0",
		"vitest": "^3.2.0"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"bin": {
		"tidysites-seed": "./bin/tidysites-seed.mjs"
